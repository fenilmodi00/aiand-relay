{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CI",
    "AIAND_API_KEY",
    "AIANDRELAY_DEBUG",
    "AIANDRELAY_LIVE_MODELS_CHECK",
    "VITEST_FILE_PARALLELISM",
    "VITEST_MAX_CONCURRENCY",
    "VITEST_RETRY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:gauntlet:core": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/**/*.test.ts",
        "src/**/*.ts",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/models/src/**"
      ],
      "outputs": []
    },
    "test:gauntlet:claude": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/claude/Claude.test.ts",
        "src/claude/scenarios.ts",
        "src/shared/assert.ts",
        "src/shared/command.ts",
        "src/shared/context.ts",
        "src/shared/context-limit.ts",
        "src/daemon/daemon-session.ts",
        "src/shared/fixture-repo.ts",
        "src/shared/json-lines.ts",
        "src/shared/long-context.ts",
        "src/shared/paths.ts",
        "src/shared/types.ts",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/models/src/**"
      ],
      "outputs": []
    },
    "test:gauntlet:codex": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/codex/Codex.test.ts",
        "src/codex/scenarios.ts",
        "src/shared/assert.ts",
        "src/codex/codex-exec.ts",
        "src/shared/command.ts",
        "src/shared/context.ts",
        "src/shared/context-limit.ts",
        "src/daemon/daemon-session.ts",
        "src/shared/fixture-repo.ts",
        "src/shared/json-lines.ts",
        "src/shared/long-context.ts",
        "src/shared/paths.ts",
        "src/shared/types.ts",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/models/src/**"
      ],
      "outputs": []
    },
    "test:gauntlet:live-models-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/shared/livemodelscheck.test.ts",
        "src/shared/assert.ts",
        "src/codex/codex-exec.ts",
        "src/shared/command.ts",
        "src/shared/context.ts",
        "src/shared/json-lines.ts",
        "src/shared/paths.ts",
        "src/shared/types.ts",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/models/src/**"
      ],
      "outputs": []
    },
    "test:gauntlet:opencode": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/opencode/OpenCode.test.ts",
        "src/opencode/scenarios.ts",
        "src/shared/assert.ts",
        "src/shared/command.ts",
        "src/shared/context.ts",
        "src/shared/json-lines.ts",
        "src/shared/long-context.ts",
        "src/shared/paths.ts",
        "src/shared/types.ts",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/models/src/**"
      ],
      "outputs": []
    },
    "test:gauntlet:pi": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "src/pi/Pi.test.ts",
        "src/pi/scenarios.ts",
        "src/shared/assert.ts",
        "src/shared/command.ts",
        "src/shared/context.ts",
        "src/shared/json-lines.ts",
        "src/shared/paths.ts",
        "src/shared/types.ts",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/models/src/**"
      ],
      "outputs": []
    }
  }
}
