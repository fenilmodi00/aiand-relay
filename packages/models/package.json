{
  "name": "@aiandrelay/models",
  "version": "0.3.0",
  "description": "Shared ai& model definitions, capabilities, and pricing for aiandrelay harnesses",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "regen-catalog": "node ./scripts/regen-catalog.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
